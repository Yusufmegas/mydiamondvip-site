# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# büyük video asset'leri — GitHub'a girmez; production'da Vercel Blob/CDN'den servis edilir
# (yerelde public/codec/ altında durur, NEXT_PUBLIC_FILM_*_URL yoksa yerel yol kullanılır)
/public/codec/*.mp4

# logs
*.log

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
