# MyDiamondVIP — environment değişkenleri (yalnızca isimler; gerçek değer YAZMAYIN)
# Gerçek değerler .env / .env.local dosyalarına konur; bunlar .gitignore'dadır.

# --- Veritabanı (Railway PostgreSQL) ---
# postgresql://KULLANICI:SIFRE@HOST:PORT/VERITABANI
DATABASE_URL=

# --- Better Auth ---
# Rastgele, uzun (32+ karakter) gizli değer. PowerShell ile üretim:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=
# Sitenin tam adresi (örn. https://www.mydiamondvip.com — local: http://localhost:3000)
AUTH_URL=

# --- S3 uyumlu Object Storage (Railway Object Storage / Cloudflare R2 / MinIO) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Yüklenen dosyaların public erişim tabanı (örn. https://cdn.ornek.com veya bucket public URL'i)
S3_PUBLIC_BASE_URL=

# --- Film kaynakları (mevcut sistem, opsiyonel) ---
NEXT_PUBLIC_FILM_720_URL=
NEXT_PUBLIC_FILM_1080_URL=

# --- Yalnızca admin:create komutu için geçici (işten sonra kaldırın) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
